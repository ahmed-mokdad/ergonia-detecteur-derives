# Copier en .env (jamais suivi par git) et renseigner. Aucune valeur ici.

# Source des données : "local" (développement) ou "http" (en ligne)
DATA_CONNECTEUR=
# Dossier HORS du dépôt contenant uniquement les fichiers ouverts (liste blanche de config/sources.yaml)
DATA_LOCAL_DIR=
# URL de base du stockage des fichiers ouverts (ConnecteurHTTP)
DATA_SOURCE_URL=

# LLM : désactivé par défaut. Ne reçoit que des agrégats issus des données ouvertes.
LLM_ACTIF=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
